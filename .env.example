# ---------------------------------------------------------------------------
# FixBondhu environment
# Copy to .env at the repo root. Never commit real values.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# PostgreSQL (Neon / Supabase / RDS / local Postgres). Use the pooled URL in
# production and the direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?schema=public"

# --- Auth -----------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-me-with-a-long-random-secret"
# Public origin used for absolute links in emails / SMS.
APP_URL="http://localhost:3000"
PRO_APP_URL="http://localhost:3001"
ADMIN_APP_URL="http://localhost:3002"

# --- Redis (optional) -----------------------------------------------------
# Enables distributed rate limiting, caching and job queues. When absent the
# app falls back to an in-process implementation (single instance only).
REDIS_URL=""

# --- Payments -------------------------------------------------------------
# Gateway is abstracted (packages/core/src/payments). The built-in gateway is
# a real, verifiable sandbox: it signs callbacks with PAYMENT_WEBHOOK_SECRET
# and payments only become CAPTURED after server-side signature verification.
PAYMENT_GATEWAY="sandbox"
PAYMENT_WEBHOOK_SECRET="replace-me"
PAYMENT_CURRENCY="BDT"

# bKash / Nagad / Rocket (Bangladesh mobile financial services).
# Leave blank to keep the gateway in sandbox mode.
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
NAGAD_MERCHANT_ID=""

# --- Commission -----------------------------------------------------------
# Platform commission in basis points. 1200 bps = 12%. Configurable in the
# admin panel (CommissionRule) - this is only the bootstrap default.
DEFAULT_COMMISSION_BPS="1200"

# --- Notifications --------------------------------------------------------
# Channels degrade gracefully: if a provider key is missing, that channel is
# skipped and recorded as SKIPPED rather than silently dropped.
RESEND_API_KEY=""
RESEND_FROM="FixBondhu <no-reply@fixbondhu.com>"
SMS_API_KEY=""
SMS_SENDER_ID="FixBondhu"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# --- Maps / geocoding (optional) -----------------------------------------
# Without a key, the app uses the bundled Bangladesh location dataset and
# centroid coordinates instead of live geocoding.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# --- Storage --------------------------------------------------------------
# S3-compatible object storage for verification documents and portfolios.
# Private bucket; documents are served through signed URLs only.
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Rate limiting --------------------------------------------------------
RATE_LIMIT_ENABLED="true"
