{
  // Verification scripts are ops tooling, not application code, so they are
  // kept out of the Next.js build and type-checked separately. They still get
  // full strict checking here rather than being silently excluded.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts", "src/lib/**/*.ts"],
  "exclude": ["node_modules"]
}
