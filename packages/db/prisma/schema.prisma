// FixBondhu — canonical data model.
//
// Conventions used throughout:
//  * Money is stored as INTEGER POISHA (1 BDT = 100 poisha). Never floats, never
//    decimals — this is a payments-heavy marketplace and floating point money is
//    a reconciliation bug waiting to happen.
//  * Display strings (name, address, price at time of booking) are SNAPSHOTTED
//    onto Booking so history stays truthful after a provider renames or reprices.
//  * Verification is never a boolean. A badge renders only from an APPROVED
//    ProviderVerification row, so it cannot be faked or go stale.
//  * Soft delete on anything an admin or a customer may need to see later
//    (deletedAt). Hard delete only for throwaway rows.

// Prisma 7 generates plain TypeScript into the repo so the client is bundled
// and tree-shaken like any other source. `importFileExtension = "ts"` keeps the
// emitted imports resolvable by tsx, which the seed and scripts run through.
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
  runtime             = "nodejs"
}

// Prisma 7 moved connection URLs out of the schema and into prisma.config.ts,
// and requires a driver adapter on the client. See packages/db/prisma.config.ts.
datasource db {
  provider = "postgresql"
}

