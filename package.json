{
  "name": "fixbondhu",
  "version": "0.1.0",
  "private": true,
  "description": "FixBondhu — verified local services marketplace for Bangladesh",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@fixbondhu/web",
    "build": "npm run db:generate && npm run build --workspace=@fixbondhu/web",
    "start": "npm run start --workspace=@fixbondhu/web",
    "verify": "npm run verify --workspace=@fixbondhu/core && npm run verify:auth --workspace=@fixbondhu/web && npm run verify:google --workspace=@fixbondhu/web && npm run verify:search --workspace=@fixbondhu/web",
    "lint": "npm run lint --workspace=@fixbondhu/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run generate --workspace=@fixbondhu/db",
    "db:migrate": "npm run migrate --workspace=@fixbondhu/db",
    "db:deploy": "npm run deploy --workspace=@fixbondhu/db",
    "db:push": "npm run push --workspace=@fixbondhu/db",
    "db:seed": "npm run seed --workspace=@fixbondhu/db",
    "db:studio": "npm run studio --workspace=@fixbondhu/db",
    "db:reset": "npm run reset --workspace=@fixbondhu/db",
    "setup": "npm install && npm run db:generate && npm run db:deploy && npm run db:seed",
    "verify:live": "npm run verify:live --workspace=@fixbondhu/web",
    "cleanup:test-accounts": "npm run cleanup:test-accounts --workspace=@fixbondhu/web",
    "seed:demo": "npm run seed:demo --workspace=@fixbondhu/web",
    "verify:booking": "npm run verify:booking --workspace=@fixbondhu/web"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@neon/config": "^1.8.2",
    "@neon/env": "^1.4.7"
  }
}
